# Copy to .env and adjust. Next.js loads .env automatically for `npm run dev` / `npm start` / ./start.sh.
# Never commit the real .env file.

# Initial password for the host account "admin" (min 8 chars). Only used when data/users.json does not exist yet.
# Without it, the first admin login needs the one-time setup code printed by the server (data/.host_setup_code).
APP_PASSWORD=

# HMAC key for session cookies (min 32 chars). If empty, a random key is generated in data/.session_secret.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SESSION_SECRET=

# AES-256-GCM key for encrypted secure backups: exactly 64 hex chars. If empty, generated in data/.backup_key.
# Keep a copy somewhere safe: backups cannot be decrypted without it.
APP_BACKUP_KEY=

# Guest self-registration (true/false) and the server-wide cap on new accounts per hour
ALLOW_REGISTRATION=true
MAX_REGISTRATIONS_PER_HOUR=30

# Public address used for link-preview (Open Graph) image URLs, e.g. your fixed ngrok domain
SITE_URL=http://localhost:3000

# start.sh options
PORT=3000
# NGROK_DOMAIN=your-name.ngrok-free.app
# NO_TUNNEL=1
